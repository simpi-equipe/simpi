# Valores exclusivos para desenvolvimento local.
# Nao reutilizar em ambientes remotos.
POSTGRES_DB=simpi_dev
POSTGRES_USER=simpi_dev
POSTGRES_PASSWORD=simpi_dev_only
POSTGRES_PORT=5432

# Backend em container na rede simpi-local_default.
DB_URL=jdbc:postgresql://postgres:5432/simpi_dev

POSTGRES_TEST_PASSWORD=simpi_test_only
# Substitua por uma chave propria: Base64 de pelo menos 32 bytes aleatorios.
# Gere localmente conforme docs/docker-backend.md#configurar-jwt.
# Nao use chaves publicas de fixtures/CI nem reutilize a chave local em producao.
# O placeholder abaixo nao e uma chave valida; nao existe fallback de producao.
JWT_SECRET=SUBSTITUA_POR_BASE64_DE_PELO_MENOS_32_BYTES_ALEATORIOS
